{
  "name": "coding-interview-practice-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:sync": "cd ../android && gradle syncWebAssets",
    "android:debug": "cd ../android && gradle assembleDebug",
    "android:release": "cd ../android && gradle assembleRelease",
    "android:install": "cd ../android && gradle installDebug",
    "android:publish": "cd .. && node scripts/publish-android-release.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.22.0",
    "markdown-it": "^14.3.0",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "vite": "^8.1.0"
  }
}
